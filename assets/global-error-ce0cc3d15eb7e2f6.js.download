          * { margin: 0; padding: 0; box-sizing: border-box; }
          body {
            font-family: system-ui, -apple-system, sans-serif;
            background: #070711;
            color: #e5e5e5;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
          }
          .card {
            max-width: 400px;
            width: 100%;
            background: rgba(20, 20, 35, 0.8);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 1rem;
            padding: 2rem 1.5rem;
            text-align: center;
            backdrop-filter: blur(20px);
            animation: fadeIn 0.5s ease;
          }
          @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
          .icon-wrap {
            display: inline-flex;
            padding: 1rem;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.15);
            border-radius: 50%;
            margin-bottom: 1.25rem;
          }
          h1 { font-size: 1.35rem; font-weight: 800; color: #f87171; margin-bottom: 0.75rem; }
          .desc { font-size: 0.875rem; color: #9ca3af; line-height: 1.6; margin-bottom: 1.5rem; }
          .btn {
            width: 100%;
            padding: 0.75rem;
            border-radius: 0.75rem;
            font-size: 0.875rem;
            font-weight: 700;
            cursor: pointer;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
          }
          .btn-primary { background: #0891b2; color: white; margin-bottom: 0.75rem; }
          .btn-primary:hover { background: #0e7490; }
          .btn-outline { background: transparent; color: #0891b2; border: 2px solid rgba(8, 145, 178, 0.35); }
          .btn-outline:hover { background: rgba(8, 145, 178, 0.08); }
          .support { font-size: 0.75rem; color: #6b7280; margin-top: 1.25rem; }
          .support a { color: #0891b2; text-decoration: none; }
          .support a:hover { text-decoration: underline; }
        `}})]}),(0,a.jsx)("body",{children:(0,a.jsxs)("div",{className:"card",children:[(0,a.jsx)("div",{className:"icon-wrap",children:(0,a.jsxs)("svg",{width:"40",height:"40",viewBox:"0 0 24 24",fill:"none",stroke:"#f87171",strokeWidth:"2",strokeLinecap:"round",strokeLinejoin:"round",children:[(0,a.jsx)("path",{d:"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"}),(0,a.jsx)("path",{d:"M12 9v4"}),(0,a.jsx)("path",{d:"M12 17h.01"})]})}),(0,a.jsx)("h1",{children:l.title}),(0,a.jsx)("p",{className:"desc",children:l.desc}),(0,a.jsxs)("button",{className:"btn btn-primary",onClick:()=>{r&&t()},children:["↻ ",l.retry]}),(0,a.jsxs)("button",{className:"btn btn-outline",onClick:()=>{window.location.href="/"},children:["⌂ ",l.home]}),(0,a.jsxs)("p",{className:"support",children:[l.support," ",(0,a.jsx)("a",{href:"/contact",children:"→"})]})]})})]})}},96882:(e,t,r)=>{"use strict";r.d(t,{A6:()=>H,C5:()=>c,Cr:()=>N,D5:()=>s,DB:()=>I,I7:()=>u,IY:()=>W,Ig:()=>o,KO:()=>A,NK:()=>i,NQ:()=>Q,Nh:()=>j,Np:()=>b,Ns:()=>X,Oi:()=>G,Q4:()=>E,TA:()=>P,W1:()=>z,Xo:()=>x,Yy:()=>h,Z0:()=>O,_S:()=>a,_y:()=>q,bm:()=>y,e9:()=>L,ew:()=>d,fh:()=>_,ft:()=>M,gw:()=>p,hg:()=>m,hr:()=>w,iu:()=>D,jK:()=>Y,k3:()=>f,k_:()=>S,li:()=>k,n0:()=>B,qE:()=>g,rE:()=>$,ru:()=>C,uk:()=>T,x_:()=>K,y_:()=>l,yw:()=>n,z9:()=>v});let a="auth_token",n="auth-storage",s="admin_token",i="user_token",o="site_language",c="language",d="preferred_language",l="cached_theme",m="cached_template",h="cached_theme_transition",p="cached_theme_animations",_="cached_daylight_palette",g="cached_daylight_primary",u="cached_daylight_accent",b="cached_theme_css_vars",f="site_settings_cache",x="site_settings_cache_timestamp",y="site_settings_cache_version",k="site_cache_version",j="init_data",w="loading_screen_settings",v="prefetch_site_settings",N="pending_payment",I="pendingPaymobOrderId",C="pendingPaymobTimestamp",E="paymob_last_order_id",z="paymob_last_version",S="cod_success_order_snapshot",A=e=>`order_access_${